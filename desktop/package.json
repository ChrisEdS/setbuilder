{
  "name": "setform",
  "productName": "SETBUILDER",
  "version": "3.1.2",
  "description": "DJ set preparation for rekordbox",
  "homepage": "https://github.com/ChrisEdS/setbuilder",
  "author": {
    "name": "SETBUILDER contributors",
    "email": "ChrisEdS@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisEdS/setbuilder.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/prepare.js",
    "start": "node scripts/prepare.js && electron .",
    "dist": "node scripts/prepare.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.setform.desktop",
    "productName": "SETBUILDER",
    "asar": true,
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle/setform",
        "to": "setform",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bundle/setform/node_modules",
        "to": "setform/node_modules"
      },
      {
        "from": "env.example",
        "to": "env.example"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "synopsis": "DJ set preparation"
    }
  }
}
