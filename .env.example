# Desktop app (Electron, port 4317). Register these redirects in the Spotify and Tidal apps
# when you use the packaged build.
# Dev server (`npm run dev`) listens on port 4327. For browser OAuth, point both
# redirects at http://127.0.0.1:4327/... instead, and register that URI with the provider.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4317/api/auth/callback

TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=http://127.0.0.1:4317/api/auth/tidal/callback
